# Salin berkas ini menjadi .env lalu isi nilainya. Jangan pernah commit .env
# yang sudah terisi: isinya memuat kredensial database dan kunci JWT.

# --- server ---
NODE_ENV=development
PORT=5000

# Jumlah proxy yang mendahului aplikasi. Dipakai app.set("trust proxy") dan
# menentukan sebanyak apa X-Forwarded-For dipercaya, yang jadi kunci rate limit
# auth. Di shared hosting biasanya 1. Isi 0 kalau aplikasinya dijalankan tanpa
# proxy sama sekali (misalnya saat localhost).
TRUST_PROXY_HOPS=1

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=science_for_life

# --- Keamanan ---
# WAJIB diganti di produksi. Aplikasi menolak start kalau JWT_SECRET masih
# memakai nilai contoh di bawah ini.
JWT_SECRET=ganti-dengan-string-acak-yang-panjang

# --- Admin (opsional) ---
# Dipakai hanya oleh `npm run seed:admin`. Email admin yang dicari kalau akunnya
# belum ada. Password TIDAK dibaca dari sini: rotasi hanya jalan bila flag
# --reset-password atau --generate diberikan, supaya password yang sudah aktif
# tidak berubah diam-diam.
ADMIN_EMAIL=ilmanainitiative@gmail.com
ADMIN_NAME=Admin Ilmana

# Seed admin ditolak di produksi kecuali nilainya 1.
ALLOW_PRODUCTION_SEED=0

# --- Fitur opsional ---
# Without key ini fitur tanya-jawab AI otomatis dimatikan.
GEMINI_API_KEY=
